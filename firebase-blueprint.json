{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A meeting room reservation or pending request for Main Meeting Room or Director's Room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "enum": ["main-meeting", "director-room"],
          "description": "Identifier of the reserved office room."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Meeting title."
        },
        "organizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Display name of the meeting organizer."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Booking date in YYYY-MM-DD format."
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Start time in 24-hour HH:MM format."
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "End time in 24-hour HH:MM format."
        },
        "notes": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional meeting agenda or AV notes."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval state of the booking request."
        },
        "createdByType": {
          "type": "string",
          "enum": ["guest", "admin"],
          "description": "Whether the booking was requested by a guest or created by admin."
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Optional Firebase Auth UID when created by a signed-in admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the request or booking was created."
        },
        "reviewedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the admin who approved or declined the request."
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the request was approved or declined."
        }
      },
      "required": [
        "roomId",
        "title",
        "organizer",
        "date",
        "startTime",
        "endTime",
        "status",
        "createdByType",
        "createdAt"
      ]
    },
    "RoomNotification": {
      "title": "RoomNotification",
      "description": "Real-time booking request, approval, rejection, or cancellation notification event.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "booking:requested",
            "booking:created",
            "booking:approved",
            "booking:rejected",
            "booking:cancelled"
          ],
          "description": "Notification event kind."
        },
        "roomId": {
          "type": "string",
          "enum": ["main-meeting", "director-room"],
          "description": "Room identifier associated with the event."
        },
        "roomName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Human-readable room name."
        },
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated booking document ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Meeting title."
        },
        "organizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Organizer name."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Booking date in YYYY-MM-DD format."
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Start time in 24-hour HH:MM format."
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "End time in 24-hour HH:MM format."
        },
        "actorType": {
          "type": "string",
          "enum": ["guest", "admin"],
          "description": "Whether the event was triggered by a guest or admin."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the notification."
        }
      },
      "required": [
        "type",
        "roomId",
        "roomName",
        "bookingId",
        "title",
        "organizer",
        "date",
        "startTime",
        "endTime",
        "actorType",
        "timestamp"
      ]
    },
    "AppSeedMeta": {
      "title": "AppSeedMeta",
      "description": "Tracks one-time office seed initialization status.",
      "type": "object",
      "properties": {
        "seeded": {
          "type": "boolean",
          "description": "True once initial demo bookings are seeded."
        },
        "seededByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin that seeded the office state."
        },
        "seededAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial seed."
        }
      },
      "required": ["seeded", "seededByUid", "seededAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Trusted office administrator role marker.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Admin role literal."
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin role was granted."
        }
      },
      "required": ["role", "assignedAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Office room bookings and pending requests for Main Meeting Room and Director's Room."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/RoomNotification" },
      "description": "Real-time booking request, approval, rejection, and cancellation notification events."
    },
    "/appMeta/{metaId}": {
      "schema": { "$ref": "#/entities/AppSeedMeta" },
      "description": "One-time initialization metadata."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Admin role registry."
    }
  }
}
