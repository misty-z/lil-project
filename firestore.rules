rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'malif0313@gmail.com'
      );
    }

    function isValidRoom(roomId) {
      return roomId is string && roomId in ['main-meeting', 'director-room'];
    }

    function isValidDate(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTime(t) {
      return t is string && t.size() == 5 && t.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isValidStatus(s) {
      return s is string && s in ['pending', 'approved', 'rejected'];
    }

    // --- Validation Blueprints ---
    function isValidBookingShape(data) {
      return data.keys().hasAll([
          'roomId', 'title', 'organizer', 'date', 'startTime', 'endTime',
          'status', 'createdByType', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'title', 'organizer', 'date', 'startTime', 'endTime',
          'notes', 'status', 'createdByType', 'createdByUid', 'createdAt',
          'reviewedByUid', 'reviewedAt'
        ])
        && isValidRoom(data.roomId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.organizer is string && data.organizer.size() >= 1 && data.organizer.size() <= 60
        && isValidDate(data.date)
        && isValidTime(data.startTime)
        && isValidTime(data.endTime)
        && data.startTime < data.endTime
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 200))
        && isValidStatus(data.status)
        && data.createdByType is string && data.createdByType in ['guest', 'admin']
        && (!data.keys().hasAny(['createdByUid']) || isValidId(data.createdByUid))
        && (!data.keys().hasAny(['reviewedByUid']) || isValidId(data.reviewedByUid));
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'type', 'roomId', 'roomName', 'bookingId', 'title', 'organizer',
          'date', 'startTime', 'endTime', 'actorType', 'timestamp'
        ])
        && data.keys().hasOnly([
          'type', 'roomId', 'roomName', 'bookingId', 'title', 'organizer',
          'date', 'startTime', 'endTime', 'actorType', 'timestamp'
        ])
        && data.type is string && data.type in [
          'booking:requested',
          'booking:created',
          'booking:approved',
          'booking:rejected',
          'booking:cancelled'
        ]
        && isValidRoom(data.roomId)
        && data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 40
        && isValidId(data.bookingId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.organizer is string && data.organizer.size() >= 1 && data.organizer.size() <= 60
        && isValidDate(data.date)
        && isValidTime(data.startTime)
        && isValidTime(data.endTime)
        && data.actorType is string && data.actorType in ['guest', 'admin']
        && data.timestamp == request.time;
    }

    function isValidAppSeedMeta(data) {
      return data.keys().hasAll(['seeded', 'seededByUid', 'seededAt'])
        && data.keys().hasOnly(['seeded', 'seededByUid', 'seededAt'])
        && data.seeded is bool
        && data.seeded == true
        && isValidId(data.seededByUid)
        && data.seededAt == request.time;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['role', 'assignedAt'])
        && data.keys().hasOnly(['role', 'assignedAt'])
        && data.role is string && data.role == 'admin'
        && data.assignedAt == request.time;
    }

    // --- Collection Rules ---

    // Bookings & Pending Meeting Requests (Publicly viewable; guest requests create 'pending'; only Admin approves/rejects/deletes)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isValidRoom(existing().roomId);
      allow list: if isValidRoom(existing().roomId);

      allow create: if isValidId(bookingId)
        && isValidBookingShape(incoming())
        && incoming().createdAt == request.time
        && !incoming().keys().hasAny(['reviewedByUid', 'reviewedAt'])
        && (
          (
            incoming().status == 'pending'
            && incoming().createdByType == 'guest'
            && !incoming().keys().hasAny(['createdByUid'])
            && existsAfter(/databases/$(database)/documents/notifications/$(bookingId + '_requested'))
          )
          ||
          (
            isAdmin()
            && incoming().status == 'approved'
            && incoming().createdByType == 'admin'
            && incoming().createdByUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/notifications/$(bookingId + '_created'))
          )
        );

      allow update: if isAdmin()
        && isValidId(bookingId)
        && isValidBookingShape(incoming())
        && existing().status == 'pending'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().reviewedByUid == request.auth.uid
        && incoming().reviewedAt == request.time
        && (
          (
            incoming().status == 'approved'
            && existsAfter(/databases/$(database)/documents/notifications/$(bookingId + '_approved'))
          )
          ||
          (
            incoming().status == 'rejected'
            && existsAfter(/databases/$(database)/documents/notifications/$(bookingId + '_rejected'))
          )
        );

      allow delete: if isAdmin()
        && isValidId(bookingId)
        && existsAfter(/databases/$(database)/documents/notifications/$(bookingId + '_cancelled'));
    }

    // Real-time Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isValidRoom(existing().roomId);
      allow list: if isValidRoom(existing().roomId);

      allow create: if isValidId(notificationId)
        && isValidNotification(incoming())
        && (
          (
            incoming().type == 'booking:requested'
            && incoming().actorType == 'guest'
            && notificationId == incoming().bookingId + '_requested'
            && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'pending'
          )
          ||
          (
            isAdmin()
            && incoming().actorType == 'admin'
            && (
              (
                incoming().type == 'booking:created'
                && notificationId == incoming().bookingId + '_created'
                && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'approved'
              )
              ||
              (
                incoming().type == 'booking:approved'
                && notificationId == incoming().bookingId + '_approved'
                && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'approved'
              )
              ||
              (
                incoming().type == 'booking:rejected'
                && notificationId == incoming().bookingId + '_rejected'
                && getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'rejected'
              )
              ||
              (
                incoming().type == 'booking:cancelled'
                && notificationId == incoming().bookingId + '_cancelled'
                && !existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId))
              )
            )
          )
        );

      allow update: if false;

      allow delete: if isAdmin() && isValidId(notificationId);
    }

    // One-time Seed Metadata
    match /appMeta/{metaId} {
      allow get: if metaId == 'seed';
      allow list: if false;
      allow create: if isAdmin()
        && metaId == 'seed'
        && isValidAppSeedMeta(incoming())
        && incoming().seededByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Trusted Admin Registry
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(userId) && isValidAdminMember(incoming());
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
